generator client {
  provider = "prisma-client-js"
  seed     = "node prisma/seedBase.js"
}

datasource db {
  provider = "mysql"
  url      = "mysql://root@localhost:3306/dev_db"
}

model User {
  id             String          @id @default(cuid())
  username       String          @unique
  password       String
  role           Role            @default(USER)
  positionId     String?
  createdAt      DateTime        @default(now())
  signUpUserId   String?         @unique
  domainRequests DomainRequest[]
  position       Position?       @relation(fields: [positionId], references: [id])
  signUpUser     signupusers?    @relation(fields: [signUpUserId], references: [id], onDelete: Cascade)

  @@index([positionId], map: "users_positionId_fkey")
  @@map("users")
}

model Position {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  users       User[]

  @@map("positions")
}

model DomainRequest {
  id                   String        @id @default(cuid())
  domain               String
  ipAddress            String?
  machineType          String        @default("PC/Mac")
  OS                   String        @default("MS Windows")
  otherMachineType     String        @default("NO")
  otherOS              String        @default("No")
  requesterName        String
  responsibleName      String
  position             String
  department           String
  institution          String
  contactP             String
  contactE             String
  responsibleContactP  String
  responsibleContactE  String
  machineAdminType     String        @default("requester")
  machineAdminName     String
  machineAdminPosition String
  machineAdminContactP String
  machineAdminContactE String
  machineRoom          String?
  machinePlace         String?
  property             Purpose       @default(InNSTRU)
  useType              Purpose       @default(NoSever)
  purpose              String        @default("NO")
  requestedAt          DateTime      @default(now())
  durationType         DurationType
  expiresAt            DateTime?
  status               RequestStatus @default(PENDING)
  approvalCooldownAt   DateTime?
  userId               String
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain_record        Domain?

  @@index([userId], map: "domain_requests_userId_fkey")
  @@map("domain_requests")
}

model Domain {
  id              String        @id @default(cuid())
  domainRequestId String        @unique
  lastUsedAt      DateTime?
  deletedAt       DateTime?
  trashExpiresAt  DateTime?
  status          DomainStatus  @default(ACTIVE)
  decideTime      DateTime?
  domainRequest   DomainRequest @relation(fields: [domainRequestId], references: [id], onDelete: Cascade)

  @@map("domains")
}

model DeletedDomainLog {
  id         String   @id @default(cuid())
  domainName String
  deletedAt  DateTime @default(now())
  reason     String

  @@map("deleted_domain_logs")
}

model signupusers {
  id          String             @id
  username    String             @unique(map: "signUpUsers_username_key")
  password    String
  contactP    String
  contactE    String
  role        signupusers_role   @default(USER)
  createdAt   DateTime           @default(now())
  status      signupusers_status @default(PENDING)
  user_record User?
}

enum Role {
  ADMIN
  USER
}

enum DurationType {
  PERMANENT
  TEMPORARY
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DomainStatus {
  ACTIVE
  EXPIRED
  TRASHED
}

enum Purpose {
  InNSTRU
  InOutNSTRU
  NoSever
  Sever
  None
}

enum signupusers_role {
  ADMIN
  USER
}

enum signupusers_status {
  PENDING
  APPROVED
  REJECTED
}
