// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  seed     = "node prisma/seed.js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id         String    @id @default(cuid())
  username   String    @unique
  password   String
  role       Role      @default(USER)
  positionId String?
  createdAt  DateTime  @default(now())
  
  position        Position? @relation(fields: [positionId], references: [id])
  domainRequests  DomainRequest[]

  signUpUser      SignUpUser?    @relation(fields: [signUpUserId], references: [id],onDelete: Cascade)
  signUpUserId    String?   @unique// foreign key มาจาก SignUpUser
  
  @@map("users")
}

model SignUpUser{
  id         String    @id @default(cuid())
  username   String    @unique
  password   String
  contactP   String
  contactE   String  
  role       Role      @default(USER)
  createdAt  DateTime  @default(now())
  status     SignUp    @default(PENDING)
  user_record User? 
  @@map("signUpUsers")
}

model Position {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())


  users User[]
  
  @@map("positions")
}

model DomainRequest {
  id                     String         @id @default(cuid())
  domain                 String
  ipAddress              String?         
  machineType            String         @default("PC/Mac")
  OS                     String         @default("MS Windows")
  otherMachineType       String         @default("NO")
  otherOS                String         @default("No")

  requesterName          String
  responsibleName        String
  position               String
  department             String
  institution            String
  contactP               String
  contactE               String  

  responsibleContactP     String        
  responsibleContactE     String    

  //ข้อมูลผู้ดูแลเครื่อง
  machineAdminType       String         @default("requester")
  machineAdminName       String        // ชื่อ-สกุล
  machineAdminPosition   String        // ตำแหน่ง
  machineAdminContactP   String        // โทรศัพท์ 
  machineAdminContactE   String        // E-mail

  //ที่ตั้งเครื่อง
  machineRoom            String?        
  machinePlace           String?   

  //วัตถุประสงค์
  property               Purpose        @default(InNSTRU)
  useType                Purpose        @default(NoSever)
  purpose                String         @default("NO")

  requestedAt            DateTime       @default(now())
  durationType           DurationType
  expiresAt              DateTime?
  status                 RequestStatus  @default(PENDING)
  approvalCooldownAt     DateTime?
  
  userId                 String
  user                   User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  domain_record          Domain?

  @@map("domain_requests")
}


model Domain {
  id              String        @id @default(cuid())
  domainRequestId String        @unique
  lastUsedAt      DateTime?
  deletedAt       DateTime?
  trashExpiresAt  DateTime?
  status          DomainStatus  @default(ACTIVE)
  decideTime      DateTime?     //เวลาอณุมัต หรือ ปฎิเสธ
  domainRequest   DomainRequest @relation(fields: [domainRequestId], references: [id], onDelete: Cascade)
  
  @@map("domains")
}

model DeletedDomainLog {
  id              String   @id @default(cuid())
  domainName      String
  deletedAt       DateTime @default(now())
  reason          String
  
  @@map("deleted_domain_logs")
}



enum Role {
  ADMIN
  USER
}

enum DurationType {
  PERMANENT
  TEMPORARY
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DomainStatus {
  ACTIVE
  EXPIRED
  TRASHED
}

enum Purpose {
  InNSTRU
  InOutNSTRU
  NoSever
  Sever
  None
}
enum SignUp {
  PENDING
  APPROVED
  REJECTED
}